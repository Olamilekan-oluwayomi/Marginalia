# Copy this file to .env.local and fill in real values.
# Never commit real secrets — .env.local is gitignored.

# --- Supabase ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key from Supabase Dashboard → Project Settings → API.
# This key is safe for the browser but is NOT the service_role key — never use
# the service role key in this project, anywhere.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Gemini (server-only) ---
# API key from Google AI Studio (https://aistudio.google.com/apikey).
# Read only on the server; never expose this in client code.
GEMINI_API_KEY=

# --- Tavily (server-only) ---
# API key from https://app.tavily.com (starts with `tvly-`).
# The live web-search provider (capped at 1,000 free credits/month).
# Read only on the server; never expose this in client code.
TAVILY_API_KEY=

# --- Groq (server-only, fallback) ---
# API key from https://console.groq.com/keys.
# Used as the fallback answer-generation provider when the primary Gemini
# provider fails with a transient condition (rate limit / overload / outage).
# Read only on the server; never expose this in client code.
GROQ_API_KEY=
# Model used by the Groq fallback. Free-tier by default.
GROQ_MODEL=openai/gpt-oss-120b
