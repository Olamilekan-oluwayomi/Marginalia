# Normalize line endings in the repository so a checkout is byte-identical on
# Windows, macOS and Linux.
#
# `prettier.config.mjs` pins `endOfLine: "lf"`, which makes LF the intended form
# for every formatted file. Without this file a Windows clone with the default
# `core.autocrlf=true` checks out CRLF, and `npm run format:check` then fails on
# files whose committed content is already correct — the checkout disagrees with
# the commit, not with Prettier.
#
# `text=auto` lets git detect text vs. binary; the `eol=lf` below overrides any
# core.autocrlf setting so the working tree always matches the blob.
* text=auto eol=lf

# Generated by Next.js; always LF, never subject to autocrlf rewriting.
next-env.d.ts text eol=lf

# Lockfiles are diff-sensitive; keep them LF and mergeable.
package-lock.json text eol=lf

# Generated by `supabase gen types typescript --linked`; regenerated in CI, so
# pin it to LF to avoid whole-file churn when contributors regenerate locally.
src/types/database.ts text eol=lf
